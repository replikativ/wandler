{:paths ["src" "resources"]
 ;; Wandler — the verified data-transformation RUNTIME (batch · incremental · async), built on the
 ;; Ansatz CIC-kernel DSL. Provides the collection/relational/record surface, the certified optimizer,
 ;; the execution modes, and the inference layer. Depends on `ansatz` (the Lean4-in-Clojure DSL).
 ;; ansatz from Clojars (the public pin). For side-by-side development use:
 ;;   org.replikativ/ansatz {:mvn/version "0.1.62"}
 :deps {org.replikativ/ansatz {:mvn/version "0.1.62"}
        metosin/malli {:mvn/version "0.16.4"}
        ;; the CPS/async-seq substrate (the async corner of the mode lattice; spindel builds on it).
        ;; Lightweight (pulls only clojure) and already transitive via ansatz; pinned here for the
        ;; verified-JIT async-seq swap adapter (wandler.jit.async-seq).
        is.simm/partial-cps {:mvn/version "0.1.57"}}
 :aliases
 {;; Side-by-side development against a LOCAL ansatz checkout (overrides the published Clojars pin),
  ;; e.g. to use the rethink-cleanups dev-experience facilities (goal-state REPL, term quotation,
  ;; precomputed-Expr-goal proofs) before they ship in a release. ansatz's deps.edn :paths include
  ;; its compiled "classes" dir, so the Java kernel is on the classpath (run `clj -T:build javac`
  ;; in ../ansatz first). Use:  clj -M:local-ansatz:test  /  clj -M:local-ansatz:repl
  :local-ansatz {:override-deps {org.replikativ/ansatz {:local/root "../ansatz"}}}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx8g" "-XX:+ExitOnOutOfMemoryError"]
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Optional LogicNG WMC backend (pure-JVM knowledge compilation) for ansatz.wmc.logicng.
  :logicng {:extra-deps {org.logicng/logicng {:mvn/version "2.6.1"}}}

  ;; Optional live spindel FRP substrate for the async/JIT path (ansatz.bridge.spindel,
  ;; wandler.jit.swap-spindel). `test-spindel` holds the spindel-only adapter test (off the default
  ;; test path so the base suite never requires spindel). Run:
  ;;   clj -M:local-ansatz:spindel:test -d test-spindel
  :spindel {:extra-deps  {org.replikativ/spindel {:local/root "../spindel"}}
            :extra-paths ["test-spindel"]}

  ;; Optional stratum in-memory SIMD columnar engine for the reducer-offload backend
  ;; (wandler.backend.stratum). We require stratum.query (NOT stratum.api), whose load graph is
  ;; parquet/hadoop-free, so the heavy import deps stay out. Needs the JDK Vector API module.
  :stratum {:extra-deps {org.replikativ/stratum {:local/root "../stratum"}}
            :jvm-opts ["--enable-native-access=ALL-UNNAMED" "--add-modules=jdk.incubator.vector"]}

  ;; Optional live datahike engine for the bridge boundary property tests.
  :datahike {:extra-deps {org.replikativ/datahike {:local/root "../datahike"}}}

  ;; Optional raster numerical backend (unboxed per-chunk SIMD/GPU) for the :array physical tag
  ;; (wandler.backend.raster). raster from Clojars; its pattern/typedclojure GIT deps don't survive the
  ;; Maven pom boundary, so they're replicated here consumer-side. Needs the JDK Vector API module.
  :raster {:extra-deps {org.replikativ/raster {:mvn/version "0.1.3"}
                        pangloss/pattern {:git/url "https://github.com/replikativ/pattern"
                                          :git/sha "7db8472e8c166c8a95705bf4f9ac9b12810766be"}
                        org.typedclojure/typed.clj.checker {:git/url "https://github.com/whilo/typedclojure"
                                                            :git/sha "5c6412026dea6a7cd24e1eb4f1b3408b350f7f4f"
                                                            :deps/root "typed/clj.checker"}}
           :jvm-opts ["--enable-native-access=ALL-UNNAMED" "--add-modules=jdk.incubator.vector"]}

  :repl {:extra-paths ["test"]
         :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                      cider/cider-nrepl {:mvn/version "0.50.2"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED" "-Xmx8g"]
         :main-opts ["-m" "nrepl.cmdline" "--middleware" "[cider.nrepl/cider-middleware]"]}}}
